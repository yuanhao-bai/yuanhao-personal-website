---
import profile from '../data/profile.json';
---

<aside class="profile-sidebar" aria-label="Profile">
  <div class="profile-image-frame">
    <img class="profile-photo" src="/profile.jpg" alt="Yuanhao Bai" width="360" height="360" />
  </div>
  <div class="profile-summary">
    <p class="profile-label">Research profile</p>
    <h1><a href="/">{profile.name}</a></h1>
    <p class="profile-role">{profile.role}</p>
    <p class="profile-affiliation">{profile.institutionShort}</p>
    <p class="profile-focus">{profile.tagline}</p>
    <nav class="profile-contact" aria-label="Profile links">
      <a href={`mailto:${profile.email}`} aria-label="Email Yuanhao Bai" title="Email">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m4 7 8 6 8-6"></path></svg>
      </a>
      <a href={profile.cvPdf} aria-label="Curriculum Vitae PDF" title="Curriculum Vitae PDF">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l4 4v14H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"></path><path d="M14 3v5h5M9 13h6M9 17h6"></path></svg>
      </a>
      <a href={profile.github} target="_blank" rel="noreferrer" aria-label="GitHub profile" title="GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.53v-2.07c-3.09.67-3.74-1.31-3.74-1.31-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.67.08-.67 1.12.08 1.71 1.15 1.71 1.15 1 .1.72 2.03 3.21 1.44.1-.73.39-1.23.71-1.51-2.47-.28-5.07-1.24-5.07-5.49 0-1.21.43-2.2 1.15-2.98-.12-.28-.5-1.41.11-2.94 0 0 .94-.3 3.05 1.14a10.5 10.5 0 0 1 5.55 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.66.11 2.94.71.78 1.14 1.77 1.14 2.98 0 4.26-2.6 5.2-5.08 5.49.4.35.76 1.03.76 2.08V22c0 .29.2.64.77.53A11.1 11.1 0 0 0 12 .9Z"></path></svg>
      </a>
    </nav>
  </div>
  <nav class="sidebar-sections" aria-label="Homepage sections">
    <span>Explore</span>
    <a href="/#about">About</a>
    <a href="/#experience">Research experience</a>
    <a href="/#education">Education</a>
    <a href="/#current-projects">Current projects</a>
    <a href="/publications">Publications</a>
  </nav>
</aside>
