---
interface Props {
  project: {
    slug: string;
    title: string;
    subtitle: string;
    status: string;
    period: string;
    summary: string;
    hardware: string[];
    software: string[];
    repository?: string;
  };
}
const { project } = Astro.props;
---

<article class="project-row">
  <div class="project-date">{project.period}</div>
  <div>
    <h2><a href={`/projects/${project.slug}`}>{project.title}</a></h2>
    <p>{project.summary}</p>
    <p class="meta">{[...project.hardware, ...project.software].slice(0, 5).join(' · ')}</p>
  </div>
</article>
