---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import publications from '../data/publications.json';
---

<BaseLayout title="Publications" description="Research outputs by Yuanhao Bai.">
  <PageIntro title="Publications & Patents" />
  <section class="container content-section">
    {publications.map((item) => (
      <article class="publication-row">
        <span>{item.year}</span>
        <div>
          <h2>{item.title}</h2>
          <p>{item.type} · {item.status} · {item.note}</p>
        </div>
      </article>
    ))}
    <p class="secondary">Peer-reviewed publications will be added as they become available.</p>
  </section>
</BaseLayout>
