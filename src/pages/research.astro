---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import research from '../data/research.json';
---

<BaseLayout title="Research" description="Research interests of Yuanhao Bai.">
  <PageIntro
    title="Research"
    description="Embedded intelligence for resource-constrained and networked physical systems."
  />
  <section class="container content-section">
    <div class="topic-list">
      {research.map((area) => (
        <article>
          <h2>{area.title}</h2>
          <p>{area.description}</p>
          <p class="meta">{area.topics.join(' · ')}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="container content-section">
    <h2>Current questions</h2>
    <ul class="plain-list">
      <li>How can homogeneous MCU nodes autonomously assume different roles?</li>
      <li>How should embedded systems adapt to changing energy and communication budgets?</li>
      <li>How can multimodal edge systems remain reliable when sensors degrade?</li>
    </ul>
  </section>
</BaseLayout>
