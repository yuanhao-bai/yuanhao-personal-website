---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';
import awards from '../data/awards.json';
import publications from '../data/publications.json';
---

<BaseLayout title="Curriculum Vitae" description="Curriculum vitae of Yuanhao Bai.">
  <PageIntro title="Curriculum Vitae" description={`${profile.role}, ${profile.institutionShort}`} />
  <section class="container content-section cv">
    <button class="print-button" onclick="window.print()">Print / Save PDF</button>
    <section>
      <h2>Research interests</h2>
      <p>Embedded AI, TinyML, distributed embedded CPS, AIoT, and safety-critical perception.</p>
    </section>
    <section>
      <h2>Experience</h2>
      <div class="cv-row"><time>2026–present</time><p><strong>Research Assistant</strong><br />{profile.institution}</p></div>
    </section>
    <section>
      <h2>Education</h2>
      <div class="cv-row"><time>Undergraduate</time><p><strong>B.Eng. in Safety Engineering</strong><br />Central South University</p></div>
    </section>
    <section>
      <h2>Projects</h2>
      {projects.map((project) => (
        <div class="cv-row"><time>{project.period}</time><p><strong>{project.title}</strong><br />{project.subtitle}</p></div>
      ))}
    </section>
    <section>
      <h2>Patent</h2>
      {publications.map((item) => (
        <div class="cv-row"><time>{item.year}</time><p><strong>{item.title}</strong><br />{item.note}</p></div>
      ))}
    </section>
    <section id="awards">
      <h2>Selected awards</h2>
      {awards.map((award) => (
        <div class="cv-row"><time>{award.year}</time><p><strong>{award.title}</strong><br />{award.level}</p></div>
      ))}
    </section>
    <section>
      <h2>Technical skills</h2>
      <p>C/C++, Python, nRF52840, ESP32, Zephyr RTOS, BLE, PyTorch, edge inference, and sensor fusion.</p>
    </section>
  </section>
</BaseLayout>
