---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<BaseLayout
  title="Research Notes"
  description="Research notes, engineering notes, tutorials, and reading notes on embedded AI, TinyML, and safety-critical systems."
>
  <PageIntro
    eyebrow="Research notes"
    title="Working ideas, engineering lessons, and technical explanations."
    description="Notes document how research questions evolve between prototypes and formal publications."
  />

  <section class="section section-soft">
    <div class="container notes-grid">
      {notes.map((note) => (
        <article class="note-card">
          <div class="note-card-meta">
            <span>{note.data.category}</span>
            <time datetime={note.data.published.toISOString()}>
              {note.data.published.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}
            </time>
          </div>
          <h2><a href={`/notes/${note.id}`}>{note.data.title}</a></h2>
          <p>{note.data.description}</p>
          <ul class="tag-list">{note.data.tags.map((tag) => <li>{tag}</li>)}</ul>
          <a class="text-link" href={`/notes/${note.id}`}>Read note →</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
