---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The requested page could not be found.">
  <section class="page-intro">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>That research trail ends here.</h1>
      <p class="page-lead">The page may have moved, or the link may be incomplete.</p>
      <p style="margin-top: 30px"><a class="button" href="/">Return home</a></p>
    </div>
  </section>
</BaseLayout>
