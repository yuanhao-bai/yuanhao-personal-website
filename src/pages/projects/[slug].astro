---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import projectData from '../../data/projects.json';

export function getStaticPaths() {
  return projectData.items.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---

<BaseLayout title={project.title} description={project.summary}>
  <PageIntro eyebrow={`${project.period} · ${project.status}`} title={project.title} description={project.subtitle} />
  <section class="container content-section project-detail">
    <div>
      <h2>Overview</h2>
      <p>{project.summary}</p>
    </div>
    <div>
      <h2>Research problem</h2>
      <p>{project.problem}</p>
    </div>
    <div>
      <h2>Approach</h2>
      <p>{project.method}</p>
    </div>
    <div>
      <h2>Stack</h2>
      <p>{[...project.hardware, ...project.software].join(' · ')}</p>
    </div>
    <div>
      <h2>Status</h2>
      <p>{project.results}</p>
    </div>
    {project.figures.length > 0 && (
      <section class="project-figures" aria-label="Selected project figures">
        <h2>Selected figures</h2>
        <div class="project-figure-grid">
          {project.figures.map((figure) => (
            <figure>
              <div class={`project-figure-image project-figure-image--${figure.kind}`}>
                <img src={figure.src} alt={figure.caption} loading="lazy" />
              </div>
              <figcaption>{figure.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
    <p><a href="/projects">← All projects</a></p>
  </section>
</BaseLayout>
