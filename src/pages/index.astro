---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';
import timeline from '../data/timeline.json';

const recent = timeline.filter((event) => event.featured).slice(0, 5);
---

<BaseLayout>
  <section class="home-intro container">
    <img src="/profile.jpg" alt="Yuanhao Bai" width="460" height="460" />
    <div>
      <h1>Yuanhao Bai</h1>
      <p class="position">{profile.role}, {profile.institutionShort}</p>
      <p>
        I work on embedded AI, TinyML, and distributed cyber-physical systems.
        My current research studies how resource-constrained devices can coordinate
        sensing and decision-making in real-world environments.
      </p>
      <p class="meta">{profile.education}</p>
      <p class="profile-links">
        <a href={`mailto:${profile.email}`}>Email</a>
        <a href="/cv">CV</a>
        <a href="/publications">Publications</a>
        <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
      </p>
    </div>
  </section>

  <section class="container content-section">
    <h2>Research interests</h2>
    <p>
      Embedded AI · TinyML · Edge Intelligence · Embedded Cyber-Physical Systems ·
      AIoT · Distributed Sensor Networks
    </p>
    <p class="secondary">
      Intelligent transportation, multimodal perception, and safety-critical AI.
    </p>
  </section>

  <section class="container content-section">
    <div class="section-title">
      <h2>Selected projects</h2>
      <a href="/projects">All projects</a>
    </div>
    <div class="project-list">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="container content-section">
    <div class="section-title">
      <h2>Recent updates</h2>
      <a href="/timeline">Full timeline</a>
    </div>
    <div class="simple-list">
      {recent.map((event) => (
        <div>
          <time>{event.displayDate}</time>
          <p>{event.title}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container content-section" id="contact">
    <h2>Contact</h2>
    <p>
      I am interested in PhD opportunities and research collaborations in embedded
      intelligence and networked physical systems.
    </p>
    <p>{profile.institution}</p>
  </section>
</BaseLayout>
