---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
import experience from '../data/experience.json';

const selectedProjects = projects.slice(0, 3);
---

<BaseLayout>
  <section class="home-about container">
    <h1>About Me</h1>
    <p>
      I am a Research Assistant at HKUST(GZ), working on distributed and
      resource-aware AI systems. My research explores how constrained devices
      and robot collectives can learn, coordinate, and act in the physical world.
    </p>
    <p class="research-interests"><strong>Interests:</strong> Multi-agent reinforcement learning, distributed AI, TinyML, and multimodal sensing.</p>
  </section>

  <section class="container content-section">
    <h2>Research Experience</h2>
    <div class="institution-list">
      {experience.research.map((item) => (
        <article class="institution-row">
          <div class={`institution-logo ${item.logoClass}`}>
            <img src={item.logo} alt={`${item.institution} logo`} loading="lazy" />
          </div>
          <div>
            <time>{item.period}</time>
            <h3>{item.title}</h3>
            <p class="institution-name">{item.institution}</p>
            <p>{item.focus}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container content-section">
    <h2>Education</h2>
    <div class="institution-list">
      {experience.education.map((item) => (
        <article class="institution-row">
          <div class={`institution-logo ${item.logoClass}`}>
            <img src={item.logo} alt={`${item.institution} logo`} loading="lazy" />
          </div>
          <div>
            <time>{item.period}</time>
            <h3>{item.title}</h3>
            <p class="institution-name">{item.institution}</p>
            <p>{item.focus}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container content-section">
    <div class="section-title">
      <h2>Selected Projects</h2>
      <a href="/projects">View all</a>
    </div>
    <div class="project-list">
      {selectedProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

</BaseLayout>
