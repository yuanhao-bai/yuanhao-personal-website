---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedProjectCard from '../components/FeaturedProjectCard.astro';
import projectData from '../data/projects.json';
import experience from '../data/experience.json';
import profile from '../data/profile.json';

const currentProjects = projectData.items.filter((project) => project.homepage);
---

<BaseLayout>
  <section class="home-about container">
    <h1>About Me</h1>
    <p>{profile.about}</p>
    <p class="research-interests"><strong>Interests:</strong> {profile.interests}</p>
  </section>

  <section class="container content-section">
    <h2>Research Experience</h2>
    <div class="institution-list">
      {experience.research.map((item) => (
        <article class="institution-row">
          <div class={`institution-logo ${item.logoClass}`}>
            {item.logos.map((logo) => <img src={logo.src} alt={logo.alt} loading="lazy" />)}
          </div>
          <div>
            <time>{item.period}</time>
            <h3>{item.title}</h3>
            <p class="institution-name">{item.institution}</p>
            <p>{item.focus}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container content-section">
    <h2>Education</h2>
    <div class="institution-list">
      {experience.education.map((item) => (
        <article class="institution-row">
          <div class={`institution-logo ${item.logoClass}`}>
            {item.logos.map((logo) => <img src={logo.src} alt={logo.alt} loading="lazy" />)}
          </div>
          <div>
            <time>{item.period}</time>
            <h3>{item.title}</h3>
            <p class="institution-name">{item.institution}</p>
            <p>{item.focus}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container content-section">
    <div class="section-title">
      <h2>Current Projects</h2>
      <a href="/projects">View all</a>
    </div>
    <div class="featured-project-grid">
      {currentProjects.map((project) => <FeaturedProjectCard project={project} />)}
    </div>
  </section>

</BaseLayout>
