---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import profile from '../data/profile.json';
import research from '../data/research.json';
import projects from '../data/projects.json';
import timeline from '../data/timeline.json';
import awards from '../data/awards.json';
import publications from '../data/publications.json';

const featuredProjects = projects.filter((project) => project.featured);
const latestNews = timeline.filter((event) => event.featured).slice(0, 5);
const keyExperience = timeline.slice(0, 6);
const patent = publications.find((item) => item.type === 'Patent');
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Embedded AI · TinyML · Networked CPS</p>
        <h1>Intelligence that lives <span>with the physical world.</span></h1>
        <p class="hero-lead">{profile.vision}</p>
        <p class="role-line">
          <strong>{profile.role}</strong> at {profile.institutionShort}<br />
          {profile.education}
        </p>
        <div class="button-row">
          <a class="button" href="/research">View research agenda <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="/cv">View curriculum vitae</a>
        </div>
      </div>

      <div class="hero-portrait" aria-label="Yuanhao Bai research identity panel">
        <div class="portrait-grid"></div>
        <div class="portrait-content">
          <span class="portrait-label">Research portfolio / 2026</span>
          <span class="monogram" aria-hidden="true">YB</span>
          <div class="portrait-caption">
            <strong>{profile.name}</strong>
            <span>{profile.role} · {profile.institutionShort}</span>
            <span>{profile.location}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="research-focus">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Research focus</p>
          <h2 id="research-focus">From constrained devices to reliable collective intelligence.</h2>
        </div>
        <p>
          My work connects efficient AI, distributed embedded systems, and multimodal safety
          applications through deployable prototypes and systems research.
        </p>
      </div>

      <div class="research-grid">
        {research.map((area, index) => (
          <article class="research-card">
            <span class="research-number">0{index + 1}</span>
            <h3>{area.title}</h3>
            <p class="research-kicker">{area.kicker}</p>
            <p>{area.description}</p>
            <ul class="tag-list">
              {area.topics.map((topic) => <li>{topic}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="selected-projects">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Selected projects</p>
          <h2 id="selected-projects">Research built on real hardware.</h2>
        </div>
        <p>
          Each project begins with a physical-system constraint and develops a complete path
          from sensing and algorithms to embedded implementation.
        </p>
      </div>

      <div class="project-list">
        {featuredProjects.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="research-evidence">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Research evidence</p>
          <h2 id="research-evidence">Early outputs and recognition.</h2>
        </div>
        <p>
          The portfolio distinguishes verified outputs from ongoing work and avoids presenting
          future plans as completed results.
        </p>
      </div>

      <div class="evidence-grid">
        <article class="evidence-card">
          <p class="eyebrow">Patent</p>
          <h3>{patent?.title}</h3>
          <p><strong>{patent?.note}</strong> · {patent?.venue}</p>
          <a class="text-link" href="/publications">View research outputs →</a>
        </article>
        <article class="evidence-card">
          <p class="eyebrow">Awards</p>
          <h3>{awards[0].title}</h3>
          <p><strong>{awards[0].level}</strong> · {awards[0].year}</p>
          <a class="text-link" href="/cv#awards">View awards and CV →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="experience">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Experience</p>
          <h2 id="experience">A research trajectory grounded in engineering practice.</h2>
        </div>
        <p>
          Key positions, research milestones, intellectual property, and academic recognition
          are presented together as a concise record.
        </p>
      </div>

      <div class="experience-list">
        {keyExperience.map((event) => (
          <article class="experience-item">
            <div class="experience-date">
              <span>{event.displayDate}</span>
              <small>{event.type}</small>
            </div>
            <div>
              <h3>{event.title}</h3>
              <p>{event.description}</p>
            </div>
          </article>
        ))}
      </div>
      <p style="margin-top: 26px">
        <a class="text-link" href="/timeline">View complete timeline →</a>
      </p>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="latest-news">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Latest news</p>
          <h2 id="latest-news">Recent research milestones.</h2>
        </div>
        <p>Concise updates on research, positions, awards, and outputs.</p>
      </div>

      <div class="news-list">
        {latestNews.map((event) => (
          <article class="news-item">
            <span class="news-date">{event.displayDate}</span>
            <span class="news-type">{event.type}</span>
            <p class="news-title">{event.title}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container">
      <div class="contact-panel">
        <div>
          <p class="eyebrow" style="color: #a8cee0">Research exchange</p>
          <h2>Interested in efficient, distributed intelligence at the edge?</h2>
          <p>
            I welcome conversations about PhD opportunities, research collaboration, embedded
            AI systems, and the design of reliable networked sensing platforms.
          </p>
        </div>
        <div class="contact-note">
          <strong>Current affiliation</strong>
          <p>{profile.institution}</p>
          <p>Contact details will be added to the central profile configuration.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
